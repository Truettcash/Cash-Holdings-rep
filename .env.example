# Example environment variables for local development
# Copy to `.env` and fill in values as appropriate.

# Sentry
VITE_SENTRY_DSN=
REACT_APP_SENTRY_DSN=

# PostHog
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=

# Node environment
NODE_ENV=development

# Postgres / Supabase
DATABASE_URL=postgres://user:password@localhost:5432/dbname
SUPABASE_URL=
# Public (client-side) key for Supabase JS — safe for browser usage
SUPABASE_ANON_KEY=

# SERVER ONLY — NEVER expose to Vite/browser code
# Privileged service role can be used by server-side tooling; do NOT add to client-side env.
SUPABASE_SERVICE_ROLE_KEY=
