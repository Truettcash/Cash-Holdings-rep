{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/studio",
      "destination": "https://athrty-customer.hatchable.site/builder/choose",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://athrty-customer.hatchable.site/login",
      "permanent": false
    }
  ]
}
